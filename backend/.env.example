PORT=3000
MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<nombre-aplicacion>
MONGODB_DB_NAME=task_api
JWT_SECRET=cambia-esta-clave-por-un-secreto-local-fuerte
JWT_EXPIRES_IN=1h
JWT_ISSUER=task-api
JWT_AUDIENCE=task-api-clients
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10